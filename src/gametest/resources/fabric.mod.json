      "io.github.r3neer.scalebrews.test.ScalePhysicsTests",
      "io.github.r3neer.scalebrews.test.ScaleMountTests",
      "io.github.r3neer.scalebrews.test.ScaleEntityTests",
      "io.github.r3neer.scalebrews.test.ScaleCompatibilityTests",
      "io.github.r3neer.scalebrews.test.ScaleBrewingTests",
      "io.github.r3neer.scalebrews.test.ScaleTemptationTests"
