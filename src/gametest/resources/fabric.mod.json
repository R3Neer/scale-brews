{
  "schemaVersion": 1,
  "id": "scalebrews-test",
  "version": "1.0.0",
  "name": "Scale Brews Tests",
  "environment": "*",
  "mixins": ["scalebrews-test.mixins.json"],
  "entrypoints": {
    "fabric-gametest": [
      "io.github.r3neer.scalebrews.test.ScaleSizeTests",
