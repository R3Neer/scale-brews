#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Preserve raw S48 evidence bytes and simulator-generated whitespace.
/docs/evidence/S48/adversarial/*.log -text -whitespace

# The independent S49 simulator receipts also hash exact raw log bytes.
/docs/evidence/S49/adversarial/*.log -text -whitespace

# S50 independent receipts retain exact raw simulator log bytes.
/docs/evidence/S50/adversarial/*.log -text -whitespace
/docs/evidence/S50/adversarial/*.javap.txt -text -whitespace

# S51 records exact original-program and simulator evidence bytes.
/docs/evidence/S51/** -text whitespace=cr-at-eol
/docs/evidence/S51/implementation/*.javap.txt -text -whitespace
/docs/evidence/S51/adversarial/*.javap.txt -text -whitespace
/docs/evidence/S51/adversarial/*.log -text -whitespace

# Exact S52 preparation/program/simulator evidence bytes.
/docs/evidence/S52/** -text whitespace=cr-at-eol
/docs/evidence/S52/implementation/*.javap.txt -text -whitespace
/docs/evidence/S52/implementation/*.log -text -whitespace
/docs/evidence/S52/adversarial/*.javap.txt -text -whitespace
/docs/evidence/S52/adversarial/*.log -text -whitespace

# Exact S53 selector/program/simulator evidence bytes.
/docs/evidence/S53/** -text whitespace=cr-at-eol
/docs/evidence/S53/implementation/*.javap.txt -text -whitespace
/docs/evidence/S53/implementation/*.log -text -whitespace
/docs/evidence/S53/adversarial/*.javap.txt -text -whitespace
/docs/evidence/S53/adversarial/*.log -text -whitespace

