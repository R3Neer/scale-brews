#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Preserve raw S48 evidence bytes and simulator-generated whitespace.
/docs/evidence/S48/adversarial/*.log -text -whitespace

# The independent S49 simulator receipts also hash exact raw log bytes.
/docs/evidence/S49/adversarial/*.log -text -whitespace

